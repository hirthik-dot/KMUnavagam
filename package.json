{
  "name": "hotel-billing-app",
  "private": true,
  "version": "1.0.6",
  "type": "commonjs",
  "main": "electron/main.js",
  "description": "Offline Hotel Billing Application",
  "author": "Hotel Management",
  "scripts": {
    "electron": "npm run dev",
    "dev": "npm run bundle:excel && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "bundle:excel": "esbuild node_modules/exceljs/excel.js --bundle --platform=node --target=node20 --format=cjs --outfile=electron/vendor/exceljs.js --log-level=warning",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:win": "npm version patch --no-git-tag-version && npm run bundle:excel && npm run build && electron-builder --win && npm run verify:build",
    "verify:build": "node scripts/verify-build.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "better-sqlite3": "^11.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "exceljs": "^4.4.0",
    "globals": "^15.13.0",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.hotel.billing",
    "productName": "Zerivo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.jpeg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
